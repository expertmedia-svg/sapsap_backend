{
  "name": "sapsap-backend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "packages/shared",
    "packages/config"
  ],
  "scripts": {
    "dev": "tsx watch apps/api/src/main.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "start": "node dist/apps/api/src/main.js",
    "build": "tsc -p apps/api/tsconfig.json",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "mongo:local": "tsx scripts/mongo-local.ts",
    "migrate": "tsx scripts/migrate.ts",
    "format": "prettier --write apps packages scripts tests README.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@nestjs/common": "^12.4.1",
    "@nestjs/core": "^12.4.1",
    "@nestjs/platform-express": "^12.4.1",
    "@nestjs/platform-socket.io": "^12.4.1",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/websockets": "^12.4.1",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "mongoose": "^9.12.0",
    "otpauth": "^9.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "mongodb-memory-server": "^11.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}

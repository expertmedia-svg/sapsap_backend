NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ouagaride?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082
# Generate a unique random secret of at least 32 characters. Never use this example in production.
AUTH_SECRET=
SMS_MODE=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# development OTPs are returned to the app for autofill only when both flags below are set
ALLOW_LOCAL_OTP=false
ROUTING_URL=https://router.project-osrm.org
# Facultatif : second fournisseur compatible OSRM. Utiliser des services dédiés en production.
ROUTING_FALLBACK_URL=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Public OSRM is development only. Configure a contracted or self-hosted service before production.
GEOCODING_URL=
# Optional private speech-to-text adapter: POST multipart audio, language=fr -> JSON {text:string}
TRANSCRIPTION_URL=
TRANSCRIPTION_API_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ouagaride-private
DOCUMENT_SCAN_URL=
DOCUMENT_SCAN_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Mobile money remains unavailable until a verified provider adapter is configured.
PAYMENT_PROVIDER=disabled
PUSH_RELAY_URL=
PUSH_RELAY_KEY=

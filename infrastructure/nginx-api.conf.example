# Replace api.example.com with the backend domain. Enable HTTPS before testing
# from phones. The Node API must use HOST=127.0.0.1 and TRUST_PROXY=loopback.
server {
    listen 80;
    server_name api.example.com;
    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Replace incoming forwarding headers; do not trust client-supplied IPs.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }
}
